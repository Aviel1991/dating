DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speeddating?schema=public"
JWT_SECRET="your-very-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# S3 Storage
S3_BUCKET="speeddating-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_ENDPOINT="https://s3.amazonaws.com"
CDN_BASE_URL="https://your-cdn.example.com"

# SMS Provider (e.g., Twilio)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Email Provider
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="SpeedDating <noreply@example.com>"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6
